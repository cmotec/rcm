# =====================================================================================
# Configuration of Remote Connections Manager (docker compose reads this as .env).
# Lines marked [REQUIRED] must be set. Everything else has a sensible default.
# Every secret value can be supplied as a file instead: <NAME>_FILE=/run/secrets/<name>
# (supported for DB_PASSWORD, ENCRYPTION_KEYS, OIDC_CLIENT_SECRET, LOCAL_ADMIN_PASSWORD,
#  OPENBAO_TOKEN, OPENBAO_SECRET_ID).
# NEVER commit the filled-in .env to source control.
# =====================================================================================

# ---------------------------------------------------------------- application
# [REQUIRED] Public URL users open in the browser (scheme + host [+ port], no trailing slash).
# Used for OIDC redirect URIs and for Origin checks of API/WebSocket requests, and as the name of the
# self-signed certificate. With the built-in TLS on a non-standard port: https://host:8443
APP_URL=https://connections.example.com
ENVIRONMENT=production
LOG_LEVEL=INFO
# json (recommended for log shipping) or console
LOG_FORMAT=json
# Interactive API documentation at /api/docs and /api/openapi.json
API_DOCS_ENABLED=true

# Container images pulled by docker-compose.yml (docker-compose.dev.yml builds them instead).
# IMAGE_PREFIX=ghcr.io/cmotec    (default; a Gitea registry: <gitea-host>/<owner>)
# IMAGE_TAG=latest               (newest release; or pin one: 1.2.0, 1.2, 1)

# Published ports of the web container (compose). HTTPS is always on (container port 8443).
HTTPS_PORT=8443
HTTP_PORT=8080
HTTP_BIND=0.0.0.0
# What the HTTP port does: redirect (to HTTPS, default) or serve (plain HTTP for a reverse proxy in
# front that terminates TLS itself; it may also connect to HTTPS_PORT and ignore the self-signed cert)
HTTP_MODE=redirect
# TLS certificate directory: tls.crt (full chain) + tls.key there are used; without them a self-signed
# certificate is created there (for the APP_URL host, or TLS_SELF_SIGNED_NAME). Default: the Docker
# volume "web-certs". A host directory must be readable and writable for uid 101, e.g.:
#   mkdir -p /srv/rcm/certs && chown 101:101 /srv/rcm/certs
# TLS_CERT_DIR=/srv/rcm/certs
# TLS_SELF_SIGNED_NAME=rcm.example.lan
# Upload size limit enforced by nginx (0 = unlimited; the API has FILE_UPLOAD_MAX_MB too)
CLIENT_MAX_BODY_SIZE=0

# ---------------------------------------------------------------- external PostgreSQL
# [REQUIRED] PostgreSQL 14+ managed outside this deployment.
DB_HOST=postgres.example.com
DB_PORT=5432
DB_NAME=connections
DB_USER=connections
# [REQUIRED]
DB_PASSWORD=change-me
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=verify-full
# CA certificate (mounted into the api container) for verify-ca / verify-full
DB_SSLROOTCERT=
# Client certificate authentication (optional)
DB_SSLCERT=
DB_SSLKEY=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
# Apply database migrations automatically at start-up (serialised with an advisory lock)
DB_MIGRATE_ON_START=true

# ---------------------------------------------------------------- encryption at rest
# [REQUIRED] AES-256 keys for credentials and other secrets, "id:base64" (32 random bytes), comma separated.
# Generate (macOS/Linux):  echo "k1:$(openssl rand -base64 32)"
#   or inside the container: docker compose run --rm api python -m app.cli generate-key
# Rotation:  add a new key, set ENCRYPTION_ACTIVE_KEY_ID to it, run `python -m app.cli rotate-keys`,
#            then remove the old key.  Losing all keys makes stored secrets unrecoverable — back them up separately.
ENCRYPTION_KEYS=k1:REPLACE_WITH_OUTPUT_OF_GENERATE_KEY
ENCRYPTION_ACTIVE_KEY_ID=k1

# ---------------------------------------------------------------- authentication: OIDC (Authentik)
OIDC_ENABLED=true
# Authentik: https://authentik.example.com/application/o/<application-slug>/  (keep the trailing slash)
OIDC_ISSUER=https://authentik.example.com/application/o/connections/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_DISPLAY_NAME=Authentik
# Redirect URI to register in the IdP:  ${APP_URL}/api/v1/auth/oidc/callback
OIDC_REDIRECT_PATH=/api/v1/auth/oidc/callback
# Where the IdP sends the user after logout (default: APP_URL/)
OIDC_POST_LOGOUT_REDIRECT_URL=
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
# Create users on first login
OIDC_AUTO_PROVISION=true
# IdP group names (comma separated) mapped to application roles. More mappings can be added in the UI.
OIDC_ADMIN_GROUPS=connections-admins
OIDC_USER_GROUPS=connections-users
OIDC_READONLY_GROUPS=connections-readonly
# Role for users without a mapped group: none (no access) | user | readonly
OIDC_DEFAULT_ROLE=none
OIDC_VERIFY_TLS=true
# How often the refresh token is used to confirm the IdP still accepts the user (minutes)
OIDC_REVALIDATE_MINUTES=15

# ---------------------------------------------------------------- authentication: local recovery accounts
# Local accounts are meant for recovery when the IdP is unavailable. Keep disabled otherwise.
LOCAL_AUTH_ENABLED=false
# If both are set and the user does not exist yet, a local administrator is created at start-up.
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------- browser sessions & API tokens
AUTH_SESSION_IDLE_MINUTES=60
AUTH_SESSION_MAX_HOURS=12
# Signage accounts (one connection on a fullscreen display): login lifetime in days, no idle timeout.
SIGNAGE_SESSION_MAX_DAYS=30
# Must be true behind HTTPS (cookies get the __Host- prefix). Only set false for plain-HTTP testing.
COOKIE_SECURE=true
API_TOKENS_ENABLED=true

# ---------------------------------------------------------------- DNS search domains
# Default search domains for single-label host names, tried in order (comma separated).
# Per-connection and per-folder search domains take precedence. FQDNs and IPs are never changed.
DNS_SEARCH_DOMAINS=
DNS_RESOLVE_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------- guacd gateway
# compose sets GUACD_HOST=guacd / GUACD_PORT=4822 for the api container.
GUACD_TLS=false
GUACD_TLS_VERIFY=true
GUACD_CA_FILE=
GUACD_CONNECT_TIMEOUT_SECONDS=10
GUACD_HANDSHAKE_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------- remote sessions
# Lifetime of the one-time WebSocket tickets
SESSION_TICKET_TTL_SECONDS=30
# Close sessions without any traffic for this long (0 = never)
SESSION_IDLE_TIMEOUT_SECONDS=28800
# How long a disconnected session can be reconnected before it is closed
SESSION_RECONNECT_GRACE_SECONDS=300
SESSION_MAX_PER_USER=30

# ---------------------------------------------------------------- certificate & host-key policies
# Default RDP certificate policy: validate | tofu (accept on first use) | ignore   (per connection overridable)
RDP_CERT_POLICY_DEFAULT=validate
# false = forbid tofu/ignore everywhere (cannot be relaxed in the UI)
RDP_CERT_ALLOW_INSECURE=true
# Default SSH host-key policy: prompt (trust on first use) | strict | accept-new
SSH_HOST_KEY_POLICY_DEFAULT=prompt
# Validate FTPS certificates by default
FTP_TLS_VERIFY_DEFAULT=true
# Extra CA bundle (inside the api container) for FTPS, OIDC and secret-provider TLS
TLS_CA_BUNDLE=

# ---------------------------------------------------------------- protocol options
RDP_DRIVE_ENABLED=true
RDP_DRIVE_ROOT=/drives
RECORDING_ENABLED=false
RECORDING_PATH=/recordings
SSH_CONNECT_TIMEOUT_SECONDS=15
SSH_KEEPALIVE_SECONDS=30
SSH_GUACD_ENGINE_ENABLED=true
# Address in the guacd network the api listens on for SSH tunnels (auto-detected when empty)
SSH_TUNNEL_BIND_HOST=
FTP_TIMEOUT_SECONDS=30
FTP_MAX_SESSIONS=50
# 0 = unlimited
FILE_UPLOAD_MAX_MB=0

# ---------------------------------------------------------------- external secrets: OpenBao / Vault (optional)
SECRET_SYNC_ENABLED=true
SECRET_SYNC_DEFAULT_INTERVAL_SECONDS=900
# Providers can also be added in the UI (Administration → Secret providers).
# Setting the variables below creates a read-only "(environment)" provider.
OPENBAO_ENABLED=true
OPENBAO_URL=
OPENBAO_NAMESPACE=
# token | approle
OPENBAO_AUTH_METHOD=token
OPENBAO_TOKEN=
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPENBAO_KV_MOUNT=secret
# Create a credential for every secret (named after the secret, keys matched to username/password/…),
# optionally only below OPENBAO_IMPORT_PATH. See docs/secret-providers.md.
OPENBAO_AUTO_IMPORT=false
OPENBAO_IMPORT_PATH=
# Secrets left out of the import, comma separated, * = any text (path below the mount or secret name)
OPENBAO_IMPORT_EXCLUDE=

# ---------------------------------------------------------------- limits & feature flags
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=600
AUDIT_RETENTION_DAYS=365
IMPORT_MAX_FILE_MB=25
FEATURE_RDM_IMPORT=true
