# HTTPS only (port 8443); there is no plain-HTTP listener.
# Certificate selection: /docker-entrypoint.d/15-tls.sh.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The api's address is looked up at run time (Docker DNS, NGINX_LOCAL_RESOLVERS from the entrypoint),
# not once at start-up: nginx starts even while the api container is down or restarting (requests get
# 502 until it is back), and follows a new IP after the api container was recreated.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
resolver_timeout 5s;

upstream api_backend {
    zone api_backend 64k;
    server ${API_UPSTREAM} resolve;
    keepalive 16;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    ssl_certificate /tmp/tls/tls.crt;
    ssl_certificate_key /tmp/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/templates/security-headers.inc;

    # Uploads are streamed to the API (no buffering, no size limit unless configured).
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # container health check
    location = /web-health { access_log off; return 200 "ok\n"; }

    location /api/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        include /etc/nginx/templates/security-headers.inc;
    }

    location = /healthz { proxy_pass http://api_backend; access_log off; }
    location = /readyz { proxy_pass http://api_backend; access_log off; }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/templates/security-headers.inc;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/templates/security-headers.inc;
        try_files $uri /index.html;
    }
}
