# HTTP server. Put a TLS-terminating reverse proxy in front of it (docs/deployment.md, "TLS").
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream api_backend {
    server ${API_UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    include /etc/nginx/templates/security-headers.inc;

    # Uploads are streamed to the API (no buffering, no size limit unless configured).
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    location = /web-health { access_log off; return 200 "ok\n"; }

    location /api/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        include /etc/nginx/templates/security-headers.inc;
    }

    location = /healthz { proxy_pass http://api_backend; access_log off; }
    location = /readyz { proxy_pass http://api_backend; access_log off; }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/templates/security-headers.inc;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/templates/security-headers.inc;
        try_files $uri /index.html;
    }
}
