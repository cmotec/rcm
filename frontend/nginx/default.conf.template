# HTTPS on 8443 (always), HTTP on 8080: redirect to HTTPS, or serve the app for a TLS-terminating
# reverse proxy in front (HTTP_MODE=serve). Certificate selection: /docker-entrypoint.d/15-tls.sh.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream api_backend {
    server ${API_UPSTREAM};
    keepalive 16;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    ssl_certificate /tmp/tls/tls.crt;
    ssl_certificate_key /tmp/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/templates/security-headers.inc;

    # Uploads are streamed to the API (no buffering, no size limit unless configured).
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    location = /web-health { access_log off; return 200 "ok\n"; }
    include /etc/nginx/templates/app-locations.inc;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    include /etc/nginx/templates/security-headers.inc;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    location = /web-health { access_log off; return 200 "ok\n"; }
    # redirect to HTTPS, or the app itself (written by 15-tls.sh from HTTP_MODE)
    include /tmp/tls/http.inc;
}
